# Runs on every SSH connection (sshd(8)). Keep a stable path to a live
# forwarded agent socket: forwarded sockets die with their connection, so
# long-running shells that captured SSH_AUTH_SOCK once go stale. Anything
# exporting SSH_AUTH_SOCK=$HOME/.ssh/agent.sock instead follows the link.
#
# Replace the link only when its target is dead. Short connections (scp,
# one-off commands, editor probes) otherwise take the link and leave it
# dead a second later, while a long-lived connection still has a live agent.
# ssh-add -l exits 2 only when it cannot reach the agent.
if [ -S "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock" ]; then
	SSH_AUTH_SOCK="$HOME/.ssh/agent.sock" ssh-add -l >/dev/null 2>&1
	if [ $? -eq 2 ]; then
		ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock"
	fi
fi
